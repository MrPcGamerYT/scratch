diff --git a/include/ui/sdl2.h b/include/ui/sdl2.h
index dbe6e3d..d201d40 100644
--- a/include/ui/sdl2.h
+++ b/include/ui/sdl2.h
@@ -40,6 +40,9 @@ struct sdl2_console {
     int hidden;
     int opengl;
     int updates;
+    /* Project Nexus, 2026-11-23: batch presents during a VGA refresh. */
+    bool nexus_batch_updates;
+    unsigned int nexus_pending_rectangles;
     int idle_counter;
     int ignore_hotkeys;
     bool gui_keysym;
diff --git a/ui/sdl2-2d.c b/ui/sdl2-2d.c
index 7305238..d301f8e 100644
--- a/ui/sdl2-2d.c
+++ b/ui/sdl2-2d.c
@@ -27,6 +27,20 @@
 #include "ui/console.h"
 #include "ui/input.h"
 #include "ui/sdl2.h"
+#include "trace.h"
+
+/* Project Nexus, 2026-11-23: batch SDL presents within a refresh.
+ * Upload dirty regions as usual, but present only once per hardware refresh.
+ * Updates outside the refresh (including asynchronous devices) still present
+ * immediately, preserving their existing latency and ordering.
+ */
+static void nexus_sdl2_present(struct sdl2_console *scon, unsigned int rectangles)
+{
+    trace_sdl2_2d_nexus_present(scon->idx, rectangles);
+    SDL_RenderClear(scon->real_renderer);
+    SDL_RenderCopy(scon->real_renderer, scon->texture, NULL, NULL);
+    SDL_RenderPresent(scon->real_renderer);
+}
 
 void sdl2_2d_update(DisplayChangeListener *dcl,
                     int x, int y, int w, int h)
@@ -37,7 +51,7 @@ void sdl2_2d_update(DisplayChangeListener *dcl,
     size_t surface_data_offset;
     assert(!scon->opengl);
 
-    if (!scon->texture) {
+    if (!scon->texture || w <= 0 || h <= 0) {
         return;
     }
 
@@ -51,9 +65,11 @@ void sdl2_2d_update(DisplayChangeListener *dcl,
     SDL_UpdateTexture(scon->texture, &rect,
                       surface_data(surf) + surface_data_offset,
                       surface_stride(surf));
-    SDL_RenderClear(scon->real_renderer);
-    SDL_RenderCopy(scon->real_renderer, scon->texture, NULL, NULL);
-    SDL_RenderPresent(scon->real_renderer);
+    if (scon->nexus_batch_updates) {
+        scon->nexus_pending_rectangles++;
+    } else {
+        nexus_sdl2_present(scon, 1);
+    }
 }
 
 void sdl2_2d_switch(DisplayChangeListener *dcl,
@@ -66,6 +82,8 @@ void sdl2_2d_switch(DisplayChangeListener *dcl,
     assert(!scon->opengl);
 
     scon->surface = new_surface;
+    /* A new texture supersedes all dirty regions from the old surface. */
+    scon->nexus_pending_rectangles = 0;
 
     if (scon->texture) {
         SDL_DestroyTexture(scon->texture);
@@ -129,7 +147,13 @@ void sdl2_2d_refresh(DisplayChangeListener *dcl)
     struct sdl2_console *scon = container_of(dcl, struct sdl2_console, dcl);
 
     assert(!scon->opengl);
+    scon->nexus_batch_updates = true;
     graphic_hw_update(dcl->con);
+    scon->nexus_batch_updates = false;
+    if (scon->nexus_pending_rectangles && scon->texture) {
+        nexus_sdl2_present(scon, scon->nexus_pending_rectangles);
+        scon->nexus_pending_rectangles = 0;
+    }
     sdl2_poll_events(scon);
 }
 
